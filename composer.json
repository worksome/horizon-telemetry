{
    "name": "worksome/horizon-telemetry",
    "description": "An Opentelemetry implementation for Laravel Horizon and queues",
    "keywords": [
        "worksome",
        "laravel",
        "horizon-telemetry"
    ],
    "homepage": "https://github.com/worksome/horizon-telemetry",
    "license": "MIT",
    "authors": [
        {
            "name": "Oliver Nybroe",
            "email": "oliver@worksome.com",
            "role": "Developer"
        },
        {
            "name": "Owen Voke",
            "email": "owen.voke@worksome.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "laravel/horizon": "^5.45",
        "open-telemetry/api": "^1.4",
        "worksome/laravel-telemetry": "^0.5.4"
    },
    "require-dev": {
        "canvural/larastan-strict-rules": "^3.0",
        "larastan/larastan": "^3.10",
        "nunomaduro/collision": "^7.12 || ^8.8",
        "orchestra/testbench": "^10.8 || ^11.0",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "worksome/coding-style": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Worksome\\HorizonTelemetry\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Worksome\\HorizonTelemetry\\Tests\\": "tests"
        }
    },
    "scripts": {
        "lint": "vendor/bin/ecs --fix",
        "test:unit": "vendor/bin/pest -p",
        "test:coverage": "vendor/bin/pest -p --coverage",
        "test:types": "vendor/bin/phpstan analyse",
        "test:style": "vendor/bin/ecs",
        "test": [
            "@test:style",
            "@test:types",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "worksome/coding-style": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Worksome\\HorizonTelemetry\\HorizonTelemetryServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
